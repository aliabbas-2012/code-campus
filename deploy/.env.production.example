# Copy this to .env.local AND .env on the server (Next.js reads .env.local;
# the Prisma CLI only reads .env — see CLAUDE.md). Fill in real values; never
# commit the filled-in file (deploy/.gitignore blocks .env.production here,
# and the root .gitignore already blocks .env / .env.local everywhere).

# Database — point at Postgres running on this server (Step 6) or a remote instance.
DATABASE_URL=postgresql://code_campus:CHANGE_ME_DB_PASSWORD@localhost:5432/code_campus

# Auth — generate a fresh secret, don't reuse the one from dev:
#   openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32
NEXTAUTH_URL=https://code-campus.countonrobert.com

# Storage
STORAGE_BASE_PATH=./storage

# Pyodide (package CDN — leave as-is, matches copy-pyodide-assets.js's default)
NEXT_PUBLIC_PYODIDE_CDN_URL=/pyodide/

# Upload limits
MAX_FILE_SIZE_MB=10
DEFAULT_STORAGE_QUOTA_MB=500

# Session
SESSION_TIMEOUT_MINUTES=1440

# --- Do NOT set these in production ---
# ALLOWED_DEV_ORIGINS is read by next.config.js but only enforced by `next dev`;
# harmless to leave unset since this server runs `next start`.
# DEV_EXPOSE_RESET_LINK must stay unset/false here — it would leak password
# reset links in the API response. Configure real email delivery instead via
# the in-app Admin -> SMTP Settings page once you're logged in as an admin.
