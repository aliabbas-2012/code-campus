// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password_hash String?
  name      String
  role      Role     @default(STUDENT)
  status    UserStatus @default(ACTIVE)

  workspace       Workspace?
  instructor_for  InstructorStudents[] @relation("instructor")
  student_for     InstructorStudents[] @relation("student")

  assignments_created    Assignment[]        @relation("instructor_assignments")
  assigned_assignments   AssignmentStudent[] @relation("assigned_student")
  submissions_as_student Submission[]        @relation("submitting_student")
  submissions_graded     Submission[]        @relation("grading_instructor")
  submission_events      SubmissionEvent[]   @relation("submission_event_actor")
  line_comments_authored LineComment[]       @relation("line_comment_author")
  line_comments_resolved LineComment[]       @relation("line_comment_resolver")
  notifications          Notification[]      @relation("notification_recipient")
  guidelines             Guidelines?         @relation("guidelines_owner")
  reopen_requests_made     ReopenRequest[]   @relation("reopen_requested_by")
  reopen_requests_resolved ReopenRequest[]   @relation("reopen_resolved_by")
  instructor_profile     InstructorProfile?  @relation("instructor_profile_owner")
  student_profile        StudentProfile?     @relation("student_profile_owner")
  password_reset_tokens  PasswordResetToken[]

  // The one admin account that can never be deleted and cannot be deleted by anyone else.
  is_super_admin Boolean @default(false)

  last_active_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model InstructorProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  user           User     @relation("instructor_profile_owner", fields: [user_id], references: [id], onDelete: Cascade)

  title           String?
  bio             String?
  specializations String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model StudentProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @unique @db.Uuid
  user      User     @relation("student_profile_owner", fields: [user_id], references: [id], onDelete: Cascade)

  bio       String?
  interests String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Workspace {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.Uuid
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  storage_quota_bytes   BigInt    @default(524288000) // 500 MB default
  storage_used_bytes    BigInt    @default(0)
  status                WorkspaceStatus @default(ACTIVE)

  projects Project[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model Project {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String   @db.Uuid
  workspace     Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name          String
  description   String?

  assignment_id String?     @db.Uuid
  assignment    Assignment? @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  submission    Submission?

  files ProjectFile[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([workspace_id, name])
  @@unique([assignment_id, workspace_id])
  @@index([workspace_id])
}

model ProjectFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String   @db.Uuid
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  
  parent_id     String?  @db.Uuid
  parent        ProjectFile? @relation("children", fields: [parent_id], references: [id], onDelete: Cascade)
  children      ProjectFile[] @relation("children")
  
  name          String
  type          FileType
  size_bytes    BigInt   @default(0)
  storage_path  String   // Server-generated opaque path
  mime_type     String?
  content       String?  // For text files, stored in DB for simplicity in Phase 1

  line_comments LineComment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, parent_id, name])
  @@index([project_id])
  @@index([parent_id])
}

enum FileType {
  FILE
  FOLDER
}

model InstructorStudents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id String   @db.Uuid
  instructor    User     @relation("instructor", fields: [instructor_id], references: [id], onDelete: Cascade)
  
  student_id    String   @db.Uuid
  student       User     @relation("student", fields: [student_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([instructor_id, student_id])
  @@index([instructor_id])
  @@index([student_id])
}

model Assignment {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id  String  @db.Uuid
  instructor     User    @relation("instructor_assignments", fields: [instructor_id], references: [id], onDelete: Cascade)
  title          String
  description    String?
  max_score      Int     @default(100)
  pass_threshold Int     @default(60)
  starter_code   String? // Seeded as solution.py into each student's project when they start the assignment

  assigned_students AssignmentStudent[]
  projects          Project[]
  submissions       Submission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([instructor_id])
}

model AssignmentStudent {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id String     @db.Uuid
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  student_id String @db.Uuid
  student    User   @relation("assigned_student", fields: [student_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
}

model Submission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String     @unique @db.Uuid
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignment_id String     @db.Uuid
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student_id    String     @db.Uuid
  student       User       @relation("submitting_student", fields: [student_id], references: [id], onDelete: Cascade)

  status SubmissionStatus @default(IN_PROGRESS)

  score     Int?
  passed    Boolean?
  submitted_at DateTime?
  graded_at    DateTime?

  graded_by_id String? @db.Uuid
  graded_by    User?   @relation("grading_instructor", fields: [graded_by_id], references: [id], onDelete: SetNull)

  // True while a reopen request is pending admin decision — the student's own
  // view of the grade/score is hidden until the admin resolves it.
  on_hold Boolean @default(false)

  events SubmissionEvent[]
  line_comments LineComment[]
  reopen_requests ReopenRequest[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  GRADED
}

model SubmissionEvent {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String     @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  type     SubmissionEventType
  actor_id String              @db.Uuid
  actor    User                @relation("submission_event_actor", fields: [actor_id], references: [id], onDelete: Cascade)

  feedback String?
  score    Int?

  created_at DateTime @default(now())

  @@index([submission_id])
}

model LineComment {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String     @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  file_id       String      @db.Uuid
  file          ProjectFile @relation(fields: [file_id], references: [id], onDelete: Cascade)

  line_number Int
  comment     String

  author_id String @db.Uuid
  author    User   @relation("line_comment_author", fields: [author_id], references: [id], onDelete: Cascade)

  resolved      Boolean   @default(false)
  resolved_by_id String?  @db.Uuid
  resolved_by   User?     @relation("line_comment_resolver", fields: [resolved_by_id], references: [id], onDelete: SetNull)
  resolved_at   DateTime?

  created_at DateTime @default(now())

  @@index([submission_id])
  @@index([file_id])
}

enum SubmissionEventType {
  SUBMITTED
  REVISION_REQUESTED
  GRADED
  CANCELLED
  REOPENED
}

model Notification {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id String   @db.Uuid
  recipient    User     @relation("notification_recipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  link    String?

  read    Boolean   @default(false)
  read_at DateTime?

  created_at DateTime @default(now())

  @@index([recipient_id])
  @@index([recipient_id, read])
}

enum NotificationType {
  SUBMISSION_RECEIVED
  REVISION_REQUESTED
  GRADED
  SUBMISSION_CANCELLED
  REOPEN_REQUESTED
  REOPEN_APPROVED
  REOPEN_DECLINED
}

model ReopenRequest {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String     @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  requested_by_id String @db.Uuid
  requested_by    User   @relation("reopen_requested_by", fields: [requested_by_id], references: [id], onDelete: Cascade)
  reason          String?

  status ReopenRequestStatus @default(PENDING)

  resolved_by_id String?   @db.Uuid
  resolved_by    User?     @relation("reopen_resolved_by", fields: [resolved_by_id], references: [id], onDelete: SetNull)
  resolved_at    DateTime?

  created_at DateTime @default(now())

  @@index([submission_id])
  @@index([status])
}

enum ReopenRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model Guidelines {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id String   @unique @db.Uuid
  instructor    User     @relation("guidelines_owner", fields: [instructor_id], references: [id], onDelete: Cascade)
  content       String

  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model SmtpSettings {
  id         String  @id @default("singleton")
  host       String
  port       Int     @default(587)
  secure     Boolean @default(false)
  username   String?
  password   String?
  from_email String
  from_name  String  @default("Code Campus")
  enabled    Boolean @default(false)

  updated_at DateTime @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?

  created_at DateTime @default(now())

  @@index([user_id])
}
