// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password_hash String?
  name      String
  role      Role     @default(STUDENT)
  status    UserStatus @default(ACTIVE)

  workspace       Workspace?
  instructor_for  InstructorStudents[] @relation("instructor")
  student_for     InstructorStudents[] @relation("student")

  assignments_created    Assignment[]        @relation("instructor_assignments")
  assigned_assignments   AssignmentStudent[] @relation("assigned_student")
  submissions_as_student Submission[]        @relation("submitting_student")
  submissions_graded     Submission[]        @relation("grading_instructor")
  submission_events      SubmissionEvent[]   @relation("submission_event_actor")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([role])
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Workspace {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.Uuid
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  storage_quota_bytes   BigInt    @default(524288000) // 500 MB default
  storage_used_bytes    BigInt    @default(0)
  status                WorkspaceStatus @default(ACTIVE)

  projects Project[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model Project {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String   @db.Uuid
  workspace     Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name          String
  description   String?

  assignment_id String?     @db.Uuid
  assignment    Assignment? @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  submission    Submission?

  files ProjectFile[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([workspace_id, name])
  @@unique([assignment_id, workspace_id])
  @@index([workspace_id])
}

model ProjectFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String   @db.Uuid
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  
  parent_id     String?  @db.Uuid
  parent        ProjectFile? @relation("children", fields: [parent_id], references: [id], onDelete: Cascade)
  children      ProjectFile[] @relation("children")
  
  name          String
  type          FileType
  size_bytes    BigInt   @default(0)
  storage_path  String   // Server-generated opaque path
  mime_type     String?
  content       String?  // For text files, stored in DB for simplicity in Phase 1

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, parent_id, name])
  @@index([project_id])
  @@index([parent_id])
}

enum FileType {
  FILE
  FOLDER
}

model InstructorStudents {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id String   @db.Uuid
  instructor    User     @relation("instructor", fields: [instructor_id], references: [id], onDelete: Cascade)
  
  student_id    String   @db.Uuid
  student       User     @relation("student", fields: [student_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([instructor_id, student_id])
  @@index([instructor_id])
  @@index([student_id])
}

model Assignment {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id  String  @db.Uuid
  instructor     User    @relation("instructor_assignments", fields: [instructor_id], references: [id], onDelete: Cascade)
  title          String
  description    String?
  max_score      Int     @default(100)
  pass_threshold Int     @default(60)

  assigned_students AssignmentStudent[]
  projects          Project[]
  submissions       Submission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([instructor_id])
}

model AssignmentStudent {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id String     @db.Uuid
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  student_id String @db.Uuid
  student    User   @relation("assigned_student", fields: [student_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
}

model Submission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String     @unique @db.Uuid
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignment_id String     @db.Uuid
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student_id    String     @db.Uuid
  student       User       @relation("submitting_student", fields: [student_id], references: [id], onDelete: Cascade)

  status SubmissionStatus @default(IN_PROGRESS)

  score     Int?
  passed    Boolean?
  submitted_at DateTime?
  graded_at    DateTime?

  graded_by_id String? @db.Uuid
  graded_by    User?   @relation("grading_instructor", fields: [graded_by_id], references: [id], onDelete: SetNull)

  events SubmissionEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  GRADED
}

model SubmissionEvent {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String     @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  type     SubmissionEventType
  actor_id String              @db.Uuid
  actor    User                @relation("submission_event_actor", fields: [actor_id], references: [id], onDelete: Cascade)

  feedback String?
  score    Int?

  created_at DateTime @default(now())

  @@index([submission_id])
}

enum SubmissionEventType {
  SUBMITTED
  REVISION_REQUESTED
  GRADED
}
