# Database
# For local PostgreSQL: postgresql://postgres:yourpassword@localhost:5432/code_campus
# For Docker: postgresql://postgres:postgres@postgres:5432/code_campus
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/code_campus

# Auth
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Storage
STORAGE_BASE_PATH=./storage

# Pyodide
NEXT_PUBLIC_PYODIDE_CDN_URL=https://cdn.jsdelivr.net/pyodide/v0.23.4/full/

# Upload limits
MAX_FILE_SIZE_MB=10
DEFAULT_STORAGE_QUOTA_MB=500

# Session
SESSION_TIMEOUT_MINUTES=1440
